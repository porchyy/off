# PostureAI backend configuration
# Copy to .env and adjust as needed.

# Where the SQLite file lives. Created on first run.
POSTUREAI_DATA_DIR=./database

# CORS allow-list for a separately-run frontend development server.
# Docker uses an nginx same-origin proxy, so it does not need "*".
POSTUREAI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server bind address.
POSTUREAI_HOST=0.0.0.0
POSTUREAI_PORT=8000

# Set these in production. The Pi installer creates a secure random token in
# the project .env and Docker enables this check automatically.
POSTUREAI_REQUIRE_ADMIN_TOKEN=false
POSTUREAI_ADMIN_TOKEN=

# Keep detailed minute scores and alerts for this many days.
POSTUREAI_RETENTION_DAYS=35

# Keep compact daily summaries for historical dashboard and monthly reports.
POSTUREAI_SUMMARY_RETENTION_DAYS=365
