# FastAPI backend image for Ergo Agent.
# Build context: repo root (so backend/ is reachable as a subpath).
# Run via: docker build -f docker/Dockerfile.backend .

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd -g 1000 appuser \
 && useradd -u 1000 -g appuser -m appuser \
 && mkdir -p /app/database \
 && chown -R appuser:appuser /app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/app ./app
RUN chown -R appuser:appuser /app

USER appuser

ENV ERGO_AGENT_DATA_DIR=/app/database \
    POSTUREAI_DATA_DIR=/app/database \
    ERGO_AGENT_PORT=8000 \
    POSTUREAI_PORT=8000

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD curl -fsS http://localhost:8000/api/health || exit 1

CMD ["python", "-m", "app"]
